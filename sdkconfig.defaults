# The stock module is an ESP8684-MINI-1-H4: ESP32-C2, RISC-V, 272 KB SRAM.
CONFIG_IDF_TARGET="esp32c2"

# esptool's hardware-measured chip detection reports this unit's crystal as
# 26MHz, not the Kconfig default of 40MHz. Left at 40 (the default), every
# crystal-derived clock ran scaled by 26/40 — including the Wi-Fi radio's
# frequency synthesis, which made the softAP transmit off-frequency: no
# crash, esp_wifi_start() returned ESP_OK, but it was invisible to every
# scanner. See docs/BENCH_NOTES.md, 2026-09-14 session.
CONFIG_XTAL_FREQ_26=y

# 4 MB, DIO - matches the stock image header and the factory flash tool config.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y

# The stock partition table, so install-over-stock stays possible.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# The app slot is 1280 K and the sibling Dragon products already build to
# ~1.15 MB without a meter driver. Optimize for size from the start.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# A bad image that boots but cannot talk to the network is otherwise only
# recoverable over serial, and this device lives behind a mains relay.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Captive-portal probes from iOS / Android / Windows arrive with 700+ bytes of
# headers; the 512 B default answers 431, which browsers render as a hard error.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=1024

# Room for logging before the portal is up.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# RAM. Measured on the bench: 47 KB free after boot, 4 KB at the low-water
# mark after a minute of browsing the web UI - one burst from running out.
# This is a smart plug: Wi-Fi throughput does not matter, headroom does.
#
# Wi-Fi hot paths live in flash instead of IRAM; on the C2 IRAM and DRAM
# share one pool, so this is heap.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
# Fewer buffers, allocated from heap during bursts (a page load is a burst).
# Defaults are 10 static RX, 32 dynamic RX, 32 dynamic TX, ~1.6 KB each.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=12
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=16
# A-MPDU holds RX buffers for reordering; worth it for throughput only.
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n

# Bambu (dc_bambu) connects to the printer's own MQTT broker, whose certificate
# is self-signed per printer with CN = serial, while DragonPWR connects by IP.
# There is no CA to verify against, so esp-tls must be allowed to skip server
# verification; without this dc_bambu cannot connect at all. The link is
# encrypted but not authenticated: something already on the LAN could pose as
# the printer and see the access code. esp-tls is used by nothing else here.
CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y
# mbedTLS for low memory: allocate record buffers only while in use, and a
# 4 KB outgoing record - DragonPWR only ever sends small MQTT packets. The
# incoming side stays at 16 KB; that is the printer's choice, not ours.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
